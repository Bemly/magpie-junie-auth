    "bridge-server.mjs",
    "lib",
    "junie-logo.png",
    "icon.svg",
    "README.md",
    "DIRECT-PROTOCOL.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin",
    "junie",
    "jetbrains",
    "grazie",
    "gpt-6-luna",
    "auth",
    "provider"
  ],
  "license": "MIT",
  "author": "Bemly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bemly/magpie-junie-auth.git"
  },
  "homepage": "https://github.com/Bemly/magpie-junie-auth#readme",
  "bugs": "https://github.com/Bemly/magpie-junie-auth/issues",
  "magpie": {
    "name": "Junie",
    "icon": "data:image/png;base64,",
    "maxConcurrency": 2,
